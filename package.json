{
  "name": "agent-crashtest",
  "version": "0.2.0",
  "description": "Crash-test your AI coding agent setup. One command, zero config: find out how easily Claude Code, Cursor & MCP can be hijacked by prompt injection.",
  "type": "module",
  "bin": {
    "agent-crashtest": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/*.test.js",
    "!dist/research"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "rm -rf dist && tsc",
    "dev": "tsc && node dist/cli.js",
    "demo": "tsc && node dist/cli.js --demo",
    "demo:svg": "tsc && node scripts/demo-svg.mjs > docs/demo.svg",
    "test": "tsc && node --test 'dist/**/*.test.js'"
  },
  "keywords": [
    "ai",
    "security",
    "prompt-injection",
    "claude-code",
    "cursor",
    "mcp",
    "agents",
    "red-team"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glibey/agent-crashtest.git"
  },
  "homepage": "https://github.com/glibey/agent-crashtest#readme",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
